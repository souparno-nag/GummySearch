# Copy this file to .env and fill in real values. .env is gitignored and MUST stay that way —
# backend/app/config.py is the only module permitted to read it (Constitution, Technology and
# Data Constraints).

# --- Reddit API credentials ---
# Create an app at https://www.reddit.com/prefs/apps to obtain these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Database ---
# Matches docker-compose.yml's default local Postgres credentials; change both together.
DATABASE_URL=postgresql+asyncpg://jammysearch:jammysearch@localhost:5432/jammysearch

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Sign-in (FR-048, FR-079; single user per R11) ---
# There is no registration endpoint. The one credential lives here, and only as a hash —
# never as a plaintext password. Generate one with:
#
#   cd backend && python -c "from app.users.auth_service import hash_password; \
#     import getpass; print(hash_password(getpass.getpass()))"
#
# Leaving AUTH_PASSWORD_HASH empty means nobody can sign in. That is deliberate: an
# unconfigured credential must fail closed, not read as "no credential required".
AUTH_USERNAME=researcher
AUTH_PASSWORD_HASH=
# How long a session stays valid, in seconds. Default is 12 hours.
SESSION_TTL_SECONDS=43200

# --- Request rate limiting (FR-080) ---
# The default allowance for endpoints that can trigger a paid call, enforced on the server.
# This is a control, not a hint: a client that ignores it still cannot exceed it. Sized for
# one person working normally, while still stopping a runaway loop from burning through a
# provider's free tier unnoticed.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Sign-in attempts, counted per calling client rather than per session — at sign-in there is
# no session to count against. Attempts are counted whatever their outcome, so the endpoint
# stays bounded for a caller who ignores the response. Ten per five minutes is unremarkable
# for someone mistyping a password and useless for guessing one.
SIGNIN_RATE_LIMIT_REQUESTS=10
SIGNIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- LLM: chat completions ---
# Groq, against an open-weight model (R1 — see research.md). Pin an explicit, currently
# available model id here; a floating "latest" alias is prohibited (Constitution VII).
# Verify the current model list at https://console.groq.com/docs/models before setting this.
GROQ_API_KEY=
GROQ_MODEL=

# --- LLM: embeddings ---
# Local HuggingFace sentence-transformers model (R1). Runs on-device — no API key, no network
# call, no per-token cost. Change only if you want a different embedding model; doing so
# requires re-embedding all existing content (see data-model.md's ContentChunk notes).
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Deployment exposure (FR-078) ---
# Leave false (or unset) to keep the application bound to the local machine only. Setting this
# to true is the explicit, deliberate opt-in required before the app may bind to a non-local
# interface — see R17 and FR-078-FR-081. Do not set this to true unless you have also reviewed
# the deployment-layer protections FR-081 deliberately leaves out of this release (transport
# security, abuse protection, monitoring).
ALLOW_REMOTE_EXPOSURE=false

# The interface the application binds when it is started programmatically. When you start it
# through the uvicorn CLI instead, the guard reads that command's `--host` argument, so this
# value is not what protects you there — `ALLOW_REMOTE_EXPOSURE` above is. Leave it on loopback.
APP_HOST=127.0.0.1
